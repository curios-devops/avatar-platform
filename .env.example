# ── API ───────────────────────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1
PROJECT_NAME=Gaussian Avatar Platform

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Cloudflare R2 Storage ─────────────────────────────────────────────────────
# Find these in: Cloudflare Dashboard → R2 → Manage R2 API Tokens
#
# S3_ENDPOINT format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY=YOUR_R2_ACCESS_KEY_ID
S3_SECRET_KEY=YOUR_R2_SECRET_ACCESS_KEY
S3_BUCKET_NAME=avatar-platform
S3_REGION=auto

# Optional: set a public-read base URL so artifact URLs are stable (no expiry).
# Enable "Allow Public Access" on the bucket, then use:
#   https://pub-HASH.r2.dev          (R2 managed domain)
#   https://assets.yourdomain.com    (custom domain via R2)
# Leave blank to use presigned URLs (private bucket).
STORAGE_PUBLIC_BASE_URL=

# ── RunPod ────────────────────────────────────────────────────────────────────
# Dashboard: https://www.runpod.io/console/serverless
RUNPOD_API_KEY=your_runpod_api_key

# Legacy endpoint — used by POST /avatar/create (video reconstruction).
RUNPOD_ENDPOINT_ID=your_legacy_video_endpoint_id

# Photo → FLAME-rigged Gaussian pipeline.
# Deploy the two workers in worker/avatar_worker/ to separate RunPod endpoints.
# Both must be set to activate real GPU reconstruction.
# Leave both blank (or set MOCK_PIPELINE=true) to use deterministic mocks.
RUNPOD_FLAME_ENDPOINT_ID=your_flame_endpoint_id        # DECA/EMOCA worker
RUNPOD_RECONSTRUCT_ENDPOINT_ID=your_lam_endpoint_id   # LAM Gaussian worker

# Force mocks even when RunPod endpoints are configured (useful for local dev).
MOCK_PIPELINE=false

# ── Processing limits ─────────────────────────────────────────────────────────
MAX_VIDEO_SIZE_MB=500
MAX_AUDIO_SIZE_MB=50
MAX_PHOTO_SIZE_MB=20
